{
  "schema_version": "1.1",
  "system_name": "APEX Ω∞ — Ahangban Artist Cover System",
  "design_version": "1.1.0",
  "prompt_version": "1.0",
  "canvas": {
    "width": 1080,
    "height": 1080,
    "aspect_ratio": "1:1",
    "format": "PNG",
    "color_space": "sRGB",
    "background": "#111111",
    "safe_area_ratio": 0.8,
    "circular_crop_preview": true
  },
  "palette": {
    "ink": "#111111",
    "charcoal": "#222222",
    "brand_blue": "#185ADB",
    "verification_gold": "#D4AF37",
    "white": "#FFFFFF"
  },
  "fonts": {
    "family": "Vazirmatn",
